<theme>
   <formatVersion>7</formatVersion>
   <!-- Button legend ON (the "footer" subset in theme.xml), at the bottom right as on the Switch 2 home ("+ Options   A OK"): menu, then the confirm
        button. Built by hand because the native legend does not fit the screen in most languages. Icons and texts share one band (y 0.895). -->
   <view name="system, grid">
      <image name="e_help_start_icon" extra="true">
         <path>./_inc/images/buttons/${buttonStyle}/start.${buttonExt}</path>
         <pos>0.5469 0.895</pos>
         <maxSize>0.045 0.06</maxSize>
         <origin>0 0</origin>
         <color>${textColor}</color>
         <zIndex>90</zIndex>
      </image>
      <text name="e_help_start_text" extra="true">
         <text>${helpMenu}</text>
         <pos>0.6000 0.895</pos>
         <size>0.15 0.06</size>
         <fontSize>0.03</fontSize>
         <color>${textColor}</color>
         <fontPath>${fontMedium}</fontPath>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <zIndex>90</zIndex>
      </text>
      <image name="e_help_a_icon" extra="true">
         <path>./_inc/images/buttons/${buttonStyle}/${confirmButton}.${buttonExt}</path>
         <pos>0.9641 0.895</pos>
         <maxSize>0.045 0.06</maxSize>
         <origin>1 0</origin>
         <color>${textColor}</color>
         <zIndex>90</zIndex>
      </image>
      <text name="e_help_a_text" extra="true">
         <text>${helpSelect}</text>
         <pos>0.9110 0.895</pos>
         <size>0.16 0.06</size>
         <fontSize>0.03</fontSize>
         <color>${textColor}</color>
         <fontPath>${fontMedium}</fontPath>
         <alignment>right</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <origin>1 0</origin>
         <zIndex>90</zIndex>
      </text>
   </view>
</theme>
